{
  "name": "composewatch",
  "version": "0.0.0-autorel",
  "description": "Beautiful interactive TUI for inspecting Docker Compose stacks over SSH + a CI-friendly streaming mode for GitHub Actions. Sibling of ecswatch for Logfox hybrid hosts.",
  "keywords": [
    "docker",
    "compose",
    "watchtower",
    "deploy",
    "tui",
    "cli",
    "ink",
    "github-actions",
    "rollout",
    "watcher",
    "ssh",
    "tailscale"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logfoxai/composewatch.git"
  },
  "bugs": {
    "url": "https://github.com/logfoxai/composewatch/issues"
  },
  "homepage": "https://github.com/logfoxai/composewatch#readme",
  "type": "module",
  "bin": {
    "composewatch": "bin/composewatch"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "test": "NODE_OPTIONS='--import tsx' kizu 'src/**/*.spec.ts'",
    "coverage": "c8 npm test",
    "dev": "node esbuild.config.mjs --watch",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint:check && npm run typecheck && npm run build && npm run test",
    "validate": "npm run lint && npm run typecheck && npm run build && npm run test"
  },
  "dependencies": {
    "chalk": "5.6.2",
    "commander": "14.0.3",
    "ink": "7.0.4",
    "ink-spinner": "5.0.0",
    "react": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "c8": "11.0.0",
    "esbuild": "0.28.0",
    "eslint": "10.4.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "kizu": "5.1.0",
    "tsx": "4.22.4",
    "typescript": "5.6.2",
    "typescript-eslint": "8.60.1"
  }
}
