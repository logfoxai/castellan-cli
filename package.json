{
  "name": "castellan-cli",
  "version": "0.0.0-autorel",
  "description": "Official CLI for Castellan — trigger rollouts and watch them settle.",
  "keywords": [
    "castellan",
    "docker",
    "compose",
    "deploy",
    "cli",
    "github-actions",
    "rollout",
    "watcher"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logfoxai/castellan-cli.git"
  },
  "bugs": {
    "url": "https://github.com/logfoxai/castellan-cli/issues"
  },
  "homepage": "https://github.com/logfoxai/castellan-cli#readme",
  "type": "module",
  "bin": {
    "castellan": "bin/castellan"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "bin/",
    "dist/",
    "assets/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "test": "NODE_OPTIONS='--import tsx' kizu 'src/**/*.spec.ts'",
    "coverage": "c8 npm test",
    "dev": "node esbuild.config.mjs --watch",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint:check && npm run typecheck && npm run build && npm run test",
    "validate": "npm run lint && npm run typecheck && npm run build && npm run test"
  },
  "dependencies": {
    "chalk": "5.6.2",
    "commander": "14.0.3"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "c8": "11.0.0",
    "esbuild": "0.28.0",
    "eslint": "10.4.1",
    "eslint-plugin-package-json": "^1.6.1",
    "kizu": "5.1.0",
    "tsx": "4.22.4",
    "typescript": "5.6.2",
    "typescript-eslint": "8.60.1"
  }
}
